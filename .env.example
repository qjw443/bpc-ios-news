# ===== 复制为 .env 并填真实值 =====

# App <-> 服务器共享密钥（openssl rand -hex 24）
API_TOKEN=CHANGE_ME

# ---- APNs（Apple Developer -> Keys -> APNs .p8）----
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_BUNDLE_ID=com.yourname.bpcnews

# ---- LLM 翻译 ----
LLM_URL=https://api.deepseek.com/chat/completions
LLM_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ---- 采集参数 ----
POLL_SECONDS=45
FETCH_CONCURRENCY=2
MAX_PUSH_AGE_SECONDS=10800
ARTICLE_TTL_DAYS=30
